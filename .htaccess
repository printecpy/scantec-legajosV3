# 1. AJUSTES BÁSICOS
Options -MultiViews -Indexes
RewriteEngine On
AddDefaultCharset UTF-8

# 2. TIPOS DE FUENTES
<IfModule mod_mime.c>
    AddType font/woff2 .woff2
    AddType font/woff .woff
    AddType application/vnd.ms-fontobject .eot
    AddType font/ttf .ttf
    AddType font/otf .otf
</IfModule>

# 3. CABECERAS DE SEGURIDAD
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection "0"
</IfModule>

# 4. CARPETAS QUE NUNCA SE SIRVEN POR HTTP (404 para no revelar que existen)
RewriteRule ^\.(git|svn|vscode|idea)(/|$) - [R=404,L]

# Solo si lo pedido existe en disco: así las rutas MVC con el mismo nombre (ej. logs/views) siguen al router
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(Config|Controller|Models|Views|Libraries|Helpers|logs|temp|tools|BD|backups|vendor|node_modules|scripts|scrips)(/|$) - [R=404,L]

# 5. ARCHIVOS SENSIBLES POR EXTENSIÓN O NOMBRE
<FilesMatch "(?i)(^\.|\.(env|lic|log|sql|md|lock|ini|bak|old|orig|tmp|ps1|bat|cmd|sh)$|^composer\.json$|^system_properties\.json$)">
    Require all denied
</FilesMatch>

# 6. SOLO index.php SE EJECUTA COMO PHP
<FilesMatch "(?i)\.(php|phtml|phar)$">
    Require all denied
</FilesMatch>
<Files "index.php">
    Require all granted
</Files>

# 7. ENRUTAMIENTO MVC
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]

ServerSignature Off